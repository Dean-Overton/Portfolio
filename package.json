{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run prerender",
    "build:no-prerender": "tsc -b && vite build",
    "prerender": "node scripts/prerender.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "npm run build && aws s3 sync dist/ s3://dean-overtons-portfolio --delete --region ap-southeast-2 && aws cloudfront create-invalidation --distribution-id E1BBT6SG74OAVT --paths \"/*\""
  },
  "dependencies": {
